{
  "name": "dsh-mahjong-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "check": "tsc --noEmit && node scripts/verify-vendor.mjs",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "token": "tsx scripts/issue-token.ts",
    "pretest": "npm run build",
    "prebuild": "npm --prefix ../frontend run build",
    "predeploy": "npm --prefix ../frontend run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^26.4.1",
    "miniflare": "^5.20260903.0-alpha",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  }
}
